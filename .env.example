# Published products and articles come from the tenant's Suite storefront.
# Both defaults are the production values, so Cloudflare Pages needs no
# variables unless this deployment is a preview or another client website.
VITE_SUITE_API_URL="https://api.suite.ng"
VITE_SUITE_STOREFRONT="techiebase"
VITE_SITE_NAME="TechieBase"
VITE_SITE_ORIGIN="https://techiebaseng.com"
VITE_SITE_DESCRIPTION="Shop genuine devices with nationwide delivery and expert support."
VITE_SUPPORT_WHATSAPP="2348143270982"
# Client deployments must never show the compiled TechieBase catalogue when
# their own Suite feed is empty or unavailable.
VITE_STATIC_FALLBACK="true"
